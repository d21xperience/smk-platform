# =============================================================================
# SMK PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# File ini adalah TEMPLATE untuk environment variables.
# 
# CARA PENGGUNAAN:
# 1. Copy file ini: cp .env.example .env
# 2. Edit .env sesuai kebutuhan (jangan commit .env ke Git!)
# 3. Restart services setelah mengubah .env
#
# CATATAN PENTING:
# - Jangan pernah commit .env ke Git (sudah ada di .gitignore)
# - Untuk production, gunakan environment variables yang berbeda
# - Semua password di sini adalah default untuk development
# =============================================================================


# =============================================================================
# DATABASE - POSTGRESQL (Source of Truth - Local Core)
# =============================================================================
# PostgreSQL digunakan di Server Lokal sebagai database utama untuk semua
# data akademik. Ini adalah Source of Truth untuk seluruh platform.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smk_dev
POSTGRES_PASSWORD=secret123
POSTGRES_DB=smk_platform

# Connection pool settings
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_MAX_OPEN_CONNS=100
POSTGRES_CONN_MAX_LIFETIME=1h

# SSL Mode (disable untuk development, require untuk production)
POSTGRES_SSLMODE=disable

# Schema naming (untuk multi-tenant di masa depan)
POSTGRES_SCHEMA=public


# =============================================================================
# DATABASE - REDIS (Cache & Event Bus)
# =============================================================================
# Redis digunakan untuk:
# - Distributed cache di Edge BFF
# - Session storage
# - Event bus (Pub/Sub) untuk Domain Events
# - Projection cache di Core Services

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# Connection settings
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Cache TTL (Time To Live) dalam detik
REDIS_CACHE_TTL=300
REDIS_SESSION_TTL=3600

# Memory limit (untuk development)
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru


# =============================================================================
# OBJECT STORAGE - MINIO
# =============================================================================
# MinIO digunakan untuk menyimpan file upload (foto siswa, dokumen, dll).
# Di production, bisa diganti dengan AWS S3 atau object storage lain.

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Bucket names
MINIO_BUCKET_STUDENTS=students
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_REPORTS=reports

# Use SSL (false untuk development)
MINIO_USE_SSL=false

# Region (untuk compatibility dengan S3)
MINIO_REGION=us-east-1


# =============================================================================
# DECENTTRALIZED STORAGE - IPFS
# =============================================================================
# IPFS digunakan untuk archive dokumen penting (ijazah, transkrip).
# Ini adalah optional, bisa di-disable jika tidak diperlukan.

IPFS_ENABLED=false
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# Pinning strategy
IPFS_PIN_STRATEGY=recursive


# =============================================================================
# FRONTEND - GENERAL SETTINGS
# =============================================================================
# Konfigurasi umum untuk semua aplikasi frontend (Quasar/Vue 3)

# Toggle mock data (true = gunakan mock, false = gunakan real backend)
USE_MOCK=true

# API Base URL (Edge BFF)
VUE_APP_API_URL=http://localhost:8080/api

# WebSocket URL (untuk real-time updates)
VUE_APP_WS_URL=ws://localhost:8080/ws

# App version (untuk cache busting)
VUE_APP_VERSION=1.0.0

# Feature flags
VUE_APP_FEATURE_PPDB=true
VUE_APP_FEATURE_REPORTING=true
VUE_APP_FEATURE_IPFS=false


# =============================================================================
# FRONTEND - AUTHENTICATION
# =============================================================================
# Konfigurasi authentication untuk frontend

# JWT token storage (localStorage atau sessionStorage)
VUE_APP_TOKEN_STORAGE=localStorage

# Token key name
VUE_APP_TOKEN_KEY=access_token

# Refresh token key name
VUE_APP_REFRESH_TOKEN_KEY=refresh_token

# Auto refresh token before expiry (in seconds)
VUE_APP_TOKEN_REFRESH_THRESHOLD=300

# Login redirect path
VUE_APP_LOGIN_REDIRECT=/login

# Dashboard redirect path (after login)
VUE_APP_DASHBOARD_REDIRECT=/dashboard


# =============================================================================
# FRONTEND - INTERNATIONALIZATION (i18n)
# =============================================================================
# Konfigurasi multi-language

# Default locale
VUE_APP_DEFAULT_LOCALE=id

# Available locales
VUE_APP_AVAILABLE_LOCALES=id,en

# Fallback locale
VUE_APP_FALLBACK_LOCALE=id


# =============================================================================
# BACKEND - EDGE BFF (Cloud Layer)
# =============================================================================
# Edge BFF adalah Backend for Frontend yang berjalan di Cloud VPS.
# Bertugas sebagai translator REST → gRPC dan cache manager.

# Gin mode (debug, release, test)
GIN_MODE=debug

# Edge BFF port
EDGE_BFF_PORT=8080

# CORS settings
EDGE_BFF_CORS_ORIGINS=http://localhost:8080,http://localhost:9000
EDGE_BFF_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
EDGE_BFF_CORS_HEADERS=Content-Type,Authorization
EDGE_BFF_CORS_CREDENTIALS=true

# Rate limiting
EDGE_BFF_RATE_LIMIT_RPS=100
EDGE_BFF_RATE_LIMIT_BURST=20

# Request timeout (in seconds)
EDGE_BFF_REQUEST_TIMEOUT=30

# SQLite cache database path
EDGE_BFF_SQLITE_PATH=./data/edge.db

# SQLite cache settings
EDGE_BFF_SQLITE_CACHE_TTL=300
EDGE_BFF_SQLITE_MAX_SIZE=100MB

# SingleFlight settings (untuk mencegah cache stampede)
EDGE_BFF_SINGLEFLIGHT_ENABLED=true
EDGE_BFF_SINGLEFLIGHT_TIMEOUT=10


# =============================================================================
# BACKEND - gRPC CLIENT (Edge BFF → Core Services)
# =============================================================================
# Konfigurasi gRPC client di Edge BFF untuk berkomunikasi dengan Core Services
# via Cloudflare Tunnel.

# Core Services gRPC endpoints
GRPC_CORE_ACADEMIC=core-academic:50051
GRPC_CORE_STUDENT=core-student:50052
GRPC_CORE_ATTENDANCE=core-attendance:50053
GRPC_CORE_ASSESSMENT=core-assessment:50054
GRPC_CORE_REPORTING=core-reporting:50055

# gRPC client settings
GRPC_CLIENT_TIMEOUT=10s
GRPC_CLIENT_RETRY_ENABLED=true
GRPC_CLIENT_MAX_RETRIES=3
GRPC_CLIENT_RETRY_DELAY=1s

# TLS settings (untuk production)
GRPC_CLIENT_TLS_ENABLED=false
GRPC_CLIENT_TLS_CERT_PATH=
GRPC_CLIENT_TLS_KEY_PATH=
GRPC_CLIENT_TLS_CA_PATH=


# =============================================================================
# BACKEND - CORE SERVICES (Local Layer)
# =============================================================================
# Konfigurasi umum untuk semua Core Services (Academic, Student, Attendance, dll)

# gRPC server port (setiap service punya port berbeda)
GRPC_PORT=50051

# Service name (untuk logging dan monitoring)
SERVICE_NAME=core-attendance

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# Metrics enabled (untuk Prometheus)
METRICS_ENABLED=true
METRICS_PORT=9090

# Health check endpoint
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health


# =============================================================================
# BACKEND - DOMAIN EVENTS (Event Bus)
# =============================================================================
# Konfigurasi untuk Event Driven Architecture menggunakan Redis Pub/Sub

# Event bus type (redis, kafka, rabbitmq)
EVENT_BUS_TYPE=redis

# Redis Pub/Sub settings
EVENT_BUS_REDIS_CHANNEL_PREFIX=smk-platform
EVENT_BUS_REDIS_CONSUMER_GROUP=core-services

# Event retry settings
EVENT_RETRY_ENABLED=true
EVENT_MAX_RETRIES=3
EVENT_RETRY_DELAY=5s

# Dead letter queue (untuk event yang gagal diproses)
EVENT_DLQ_ENABLED=true
EVENT_DLQ_CHANNEL=dead-letter


# =============================================================================
# BACKEND - PROJECTION (Read Model)
# =============================================================================
# Konfigurasi untuk Projection Pattern (CQRS Read Model)

# Projection storage (sqlite, redis, postgresql)
PROJECTION_STORAGE=redis

# Projection cache TTL (in seconds)
PROJECTION_CACHE_TTL=600

# Projection rebuild strategy (event-driven, scheduled, manual)
PROJECTION_REBUILD_STRATEGY=event-driven

# Projection sync interval (untuk scheduled rebuild, in seconds)
PROJECTION_SYNC_INTERVAL=3600


# =============================================================================
# BACKEND - AUTHENTICATION & AUTHORIZATION
# =============================================================================
# Konfigurasi JWT dan role-based access control

# JWT secret key (WAJIB diganti di production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT issuer
JWT_ISSUER=smk-platform

# JWT audience
JWT_AUDIENCE=smk-platform-users

# Token expiry (in seconds)
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800

# Password hashing (bcrypt cost)
BCRYPT_COST=12

# Role-based access control
RBAC_ENABLED=true


# =============================================================================
# CLOUDFLARE TUNNEL
# =============================================================================
# Konfigurasi untuk Cloudflare Tunnel (menghubungkan Edge ke Core)

# Tunnel token (dapatkan dari Cloudflare Dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Tunnel name
CLOUDFLARE_TUNNEL_NAME=smk-platform-tunnel

# Tunnel protocol (http2, quic)
CLOUDFLARE_TUNNEL_PROTOCOL=http2

# No auto-update (untuk stability)
CLOUDFLARE_NO_AUTOUPDATE=true


# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Konfigurasi untuk monitoring dan centralized logging

# Enable distributed tracing
TRACING_ENABLED=false
TRACING_PROVIDER=jaeger
TRACING_ENDPOINT=http://localhost:14268/api/traces

# Enable metrics collection
METRICS_ENABLED=true
METRICS_PROVIDER=prometheus
METRICS_PORT=9090

# Structured logging
LOG_STRUCTURED=true
LOG_OUTPUT=stdout

# Log retention (in days)
LOG_RETENTION_DAYS=30


# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
# Konfigurasi untuk backup otomatis

# Enable automatic backup
BACKUP_ENABLED=true

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (in days)
BACKUP_RETENTION_DAYS=7

# Backup storage path
BACKUP_PATH=/backup

# Backup compression
BACKUP_COMPRESSION=true

# Upload to remote storage (S3, GCS, etc)
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_TYPE=s3
BACKUP_REMOTE_BUCKET=smk-platform-backups
BACKUP_REMOTE_REGION=ap-southeast-1


# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Konfigurasi khusus untuk development

# Enable debug mode
DEBUG_MODE=true

# Enable hot reload (untuk backend)
HOT_RELOAD_ENABLED=true

# Enable SQL query logging
SQL_LOG_ENABLED=true

# Enable slow query logging (threshold in milliseconds)
SLOW_QUERY_THRESHOLD=1000

# Enable request/response logging
HTTP_LOG_ENABLED=true

# Enable gRPC logging
GRPC_LOG_ENABLED=true


# =============================================================================
# TESTING
# =============================================================================
# Konfigurasi untuk testing environment

# Test database URL (isolated dari development)
TEST_POSTGRES_URL=postgres://smk_test:test123@localhost:5432/smk_platform_test

# Test Redis URL
TEST_REDIS_URL=redis://localhost:6379/1

# Enable test coverage
TEST_COVERAGE_ENABLED=true

# Test coverage threshold (percentage)
TEST_COVERAGE_THRESHOLD=80


# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Override settings untuk production
# Uncomment dan edit sesuai kebutuhan

# POSTGRES_SSLMODE=require
# POSTGRES_PASSWORD=<strong-production-password>
# REDIS_PASSWORD=<strong-redis-password>
# MINIO_ACCESS_KEY=<production-access-key>
# MINIO_SECRET_KEY=<production-secret-key>
# JWT_SECRET=<strong-jwt-secret-at-least-32-chars>
# GIN_MODE=release
# LOG_LEVEL=warn
# DEBUG_MODE=false
# CLOUDFLARE_TUNNEL_TOKEN=<production-tunnel-token>