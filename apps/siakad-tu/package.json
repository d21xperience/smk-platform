{
  "name": "siakad-tu",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "SIAKAD TU",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare --silent",
    "test:domain": "node src/domain/student/__tests__/Student.test.js",
    "test:engine": "node src/engine/student/__tests__/StudentEngine.test.js",
    "test:formatters": "node src/composables/student/__tests__/studentFormatters.test.js",
    "test:validators": "node src/composables/student/__tests__/studentValidators.test.js",
    "test:pure": "node scripts/run-pure-tests.js"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "apexcharts": "^6.10.0",
    "axios": "^1.18.1",
    "pinia": "^3.0.1",
    "quasar": "^2.20.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@quasar/app-vite": "^3.0.0-rc.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.27",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "vite-plugin-checker": "^0.12.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
