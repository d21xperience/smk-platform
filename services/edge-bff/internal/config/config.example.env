# Application
APP_NAME=edge-bff
APP_ENV=development
SERVICE_NAME=edge-guru

# HTTP Server
SERVER_PORT=8080
SERVER_TIMEOUT_SECONDS=30

# tu-core gRPC
TUCORE_ADDRESS=localhost:50051
TUCORE_TIMEOUT_SECONDS=30

# NATS
NATS_URL=nats://localhost:4222
NATS_DURABLE_NAME=edge-guru
NATS_STREAM_NAME=SDP_EVENTS

# SQLite Read Model
SQLITE_PATH=./data/edge-guru.db

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_ISSUER=school-platform
JWT_EXPIRATION_HOURS=24
