# Application
APP_NAME=tu-core
APP_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tu_core
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME_MINUTES=5

# NATS
NATS_URL=nats://localhost:4222
NATS_CONNECTION_NAME=tu-core
NATS_STREAM_NAME=SDP_EVENTS

# gRPC Server
SERVER_PORT=50051
SERVER_TIMEOUT_SECONDS=30
